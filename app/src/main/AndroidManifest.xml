<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ============================ TV declarations ============================
      `android.software.leanback` marks the app as an Android TV app so that it
      shows up in the TV launcher, but it is declared as NOT required so the app
      also installs on phones and tablets, where the UI adapts to portrait.
      `touchscreen` is likewise optional — TVs have none.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      ========================== Package visibility ===========================
      Starting with Android 11 (API 30) apps can only see a filtered list of the
      installed packages. QUERY_ALL_PACKAGES is required because the whole point
      of this app is to enumerate *every* installed application, including the
      sideloaded mobile ones that are hidden from the TV launcher.

      NOTE: this permission is restricted on Google Play. That is fine here —
      the app is distributed as a sideloaded APK / F-Droid style build.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Needed to open the "App info" system screen and to request uninstall. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Lets the app hand generated shortcut APKs to the package installer. The
      user still confirms every install, and from API 26 must additionally grant
      "install unknown apps" to this app in system settings.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      <queries> is the finer-grained alternative used on devices where
      QUERY_ALL_PACKAGES is stripped away. We declare both intent filters we
      care about: the classic phone launcher and the leanback launcher.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TvShortcutApplication"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvShortcutMaker"
        tools:targetApi="34">

        <!-- Main app drawer. CATEGORY_LEANBACK_LAUNCHER puts it on the TV home screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.TvShortcutMaker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Kept so the app is also reachable on phones/tablets while debugging. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Invisible proxy activity. Every pinned shortcut we create points here
          with EXTRA_PACKAGE_NAME; the proxy resolves the real launch intent and
          forwards to it. This indirection is what makes the shortcut survive
          app updates and lets us fall back between LAUNCHER / LEANBACK_LAUNCHER
          entry points.
        -->
        <activity
            android:name=".launch.LaunchProxyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TvShortcutMaker.Transparent">
            <intent-filter>
                <action android:name="com.tvshortcut.maker.LAUNCH_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Receives the outcome of install sessions. Not exported: the system
          delivers to it through our own PendingIntent, so no other app needs
          access.
        -->
        <receiver
            android:name=".data.apk.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tvshortcut.maker.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
