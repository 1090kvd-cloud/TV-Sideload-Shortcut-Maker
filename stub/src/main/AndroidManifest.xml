<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================ SHORTCUT STUB TEMPLATE ============================

  This module is never shipped on its own. Its compiled APK is bundled inside the
  main app's assets as `stub-template.apk` and used as a template: at runtime the
  main app copies it, patches a few bytes, replaces the banner, re-signs it and
  hands it to the package installer. The result is a real installed package that
  every TV launcher shows — which is exactly why this approach works on firmwares
  that ignore pinned shortcuts.

  THE PLACEHOLDER TRICK
  ─────────────────────
  Strings inside a compiled (binary) AndroidManifest.xml live in a length-prefixed
  string pool. Rewriting that pool correctly is the fragile part of every APK
  generator. We avoid it entirely: the two values that must change per shortcut
  are declared here as placeholders of a FIXED length, so the patcher can
  overwrite them in place, byte for byte, without touching any offset.

    - package: from applicationId, `com.tvshortcut.s.` + 32 chars -> hash
    - label:   exactly 48 chars                        -> app name, space-padded

  DO NOT change the length of either placeholder without updating
  StubPatcher.kt, which asserts on them.

  The target package name is NOT stored here — it lives in assets/target.txt,
  a plain file the patcher can rewrite at any length.

  targetSdk is deliberately kept at 29: below API 30 the package-visibility
  filtering does not apply, so the stub can resolve and launch its target without
  QUERY_ALL_PACKAGES, and v1 (JAR) signing remains valid for installation.
-->
<!--
  NOTE: there is deliberately no `package=` attribute here. AGP 8 rejects it —
  the namespace comes from build.gradle.kts, and the placeholder package name is
  injected into the COMPILED manifest from `applicationId`. The placeholder is
  therefore still present in the built APK, which is all the patcher needs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/appicon"
        android:label="LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="com.tvshortcut.stub.StubLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Both categories: the leanback one puts the stub on the TV home
                     screen, the classic one keeps it reachable on phone launchers. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
